# BrudaGate — Environment Configuration
# ======================================

# App
APP_PORT=3000
APP_NAME=brudagate

# PostgreSQL — Railway provides DATABASE_URL automatically
# You can either use DATABASE_URL (preferred) or individual vars below:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Individual PostgreSQL vars (fallback):
DB_HOST=postgres
DB_PORT=5432
DB_USER=brudagate
DB_PASS=brudagate
DB_NAME=brudagate

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Webhook settings
WEBHOOK_RETRY_ATTEMPTS=5
WEBHOOK_RETRY_DELAY=1000
